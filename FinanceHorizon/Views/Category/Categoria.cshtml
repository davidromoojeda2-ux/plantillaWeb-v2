@model CategoryPageViewModel
@using FinanceHorizon.Models.Home
@{
    var title = Model.ParentCategory != null
        ? $"{Model.Category.Name} - {Model.ParentCategory.Name}"
        : Model.Category.Name;
    ViewData["Title"] = title;
    ViewData["MetaDescription"] = Model.Category.Description ?? $"Noticias y artículos de {Model.Category.Name}";
}


<div class="public-page">
    <!-- ─── 1. Cabecera Hero de Extremo a Extremo (Full Width) ───────────────── -->
    <header class="page-hero category-hero">

        <div class="container page-hero__inner">
            <!-- Breadcrumb -->
            <nav class="page-hero__breadcrumb" aria-label="Migas de pan">
                <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-1 transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10" />
                    </svg>
                    Inicio
                </a>
                <span>/</span>
                @if (Model.ParentCategory != null)
                {
                    <a asp-controller="Category" asp-action="Categoria"
                       asp-route-slug="@Model.ParentCategory.Slug">@Model.ParentCategory.Name</a>
                    <span>/</span>
                }
                <span class="page-hero__breadcrumb-current">@Model.Category.Name</span>
            </nav>

            @* Categoría centrada arriba; debajo, el artículo más reciente con imagen (imagen + texto a la derecha).
               Misma composición en categorías y subcategorías. *@
            <div class="category-hero__intro">
                <h1 class="page-hero__title">@Model.Category.Name</h1>

                @if (!string.IsNullOrEmpty(Model.Category.Description))
                {
                    <p class="page-hero__subtitle">@Model.Category.Description</p>
                }

                <div class="page-hero__count">
                    <span><strong>@Model.TotalCount</strong> publicaciones</span>
                </div>
            </div>

            @if (Model.HeroArticle is not null)
            {
                <div class="category-hero__lead">
                    <partial name="Partials/_LeadArticle" model="Model.HeroArticle" />
                </div>
            }
        </div>
    </header>

    @* Subcategorías: menú numerado bajo el hero, solo cuando existen *@
    @if (Model.HasSubcategories)
    {
        <nav class="page-submenu"
             aria-label="@(Model.ParentCategory != null ? "Otras subcategorías de " + Model.ParentCategory.Name : "Subcategorías de " + Model.Category.Name)">
            <div class="container">
                <div class="page-submenu__header">
                    <p class="hp-label">@(Model.ParentCategory != null ? $"Más en {Model.ParentCategory.Name}" : "Subcategorías")</p>
                    @if (Model.ParentCategory != null)
                    {
                        <a class="page-submenu__all" asp-controller="Category" asp-action="Categoria"
                           asp-route-slug="@Model.ParentCategory.Slug">
                            <span>Ver todo en @Model.ParentCategory.Name</span>
                            <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M1 0l9 5-9 5z" fill="currentColor" /></svg>
                        </a>
                    }
                </div>
                <ol class="page-submenu__list" role="list">
                    @{ var subIndex = 0; }
                    @foreach (var sub in Model.Subcategories!)
                    {
                        subIndex++;
                        var isCurrent = sub.Slug == Model.Category.Slug;
                        <li>
                            <a class="page-submenu__link" asp-controller="Category" asp-action="Categoria" asp-route-slug="@sub.Slug"
                               aria-current="@(isCurrent ? "page" : null)">
                                <span class="page-submenu__num" aria-hidden="true">@subIndex.ToString("00")</span>
                                <span class="page-submenu__name">@sub.Name</span>
                                <svg class="page-submenu__arrow" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M1 0l9 5-9 5z" fill="currentColor" /></svg>
                            </a>
                        </li>
                    }
                </ol>
            </div>
        </nav>
    }

            <!-- ─── 2. Contenido de Extremo a Extremo (Mismo contenedor de la Home) ─── -->
            <section class="page-content-section container" aria-label="Contenido">
                @if (!Model.Articles.Any())
                {
                    <div class="hp-empty">
                        <h2 class="hp-empty__title">Aún no hay publicaciones</h2>
                        <p class="hp-empty__text">Vuelve pronto para consultar nuevas guías y noticias de esta categoría.</p>
                        <a asp-controller="Home" asp-action="Index" class="hp-btn hp-btn--primary">
                            <span>Volver al inicio</span>
                            <svg class="hp-btn__icon" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M1 0l9 5-9 5z" fill="currentColor" /></svg>
                        </a>
                    </div>
                }
                else
                {
                    @* El artículo de la cabecera no se repite en la rejilla (GridArticles) *@
                    @if (Model.GridArticles.Any())
                    {
                    <ul class="hp-grid hp-grid--3" role="list">
                        @{
                            var cardIndex = 0;
                        }
                        @foreach (var art in Model.GridArticles)
                        {
                            ViewData["PostCardPriority"] = cardIndex++ == 0;
                            <partial name="Partials/_PostCard" model="art" />
                        }
                    </ul>
                    }

                    <!-- ─── Paginación Modular Reutilizable ───────────────────────────── -->
                    <partial name="Partials/_Pagination"
                             model="PaginationViewModel.ForCategory(Model.CurrentPage, Model.TotalPages, Model.Category.Slug)" />
                }
            </section>
        </div>

        @section StructuredData {
            @{
                var structuredDataBaseUrl = SiteUrl.Resolve(Context, Configuration);
                var pageUrl = Model.CurrentPage > 1
                    ? $"/categoria/{Model.Category.Slug}?page={Model.CurrentPage}"
                    : $"/categoria/{Model.Category.Slug}";

                var breadcrumb = new List<BreadcrumbItem> { new("Inicio", "/") };
                if (Model.ParentCategory != null)
                    breadcrumb.Add(new(Model.ParentCategory.Name, $"/categoria/{Model.ParentCategory.Slug}"));
                breadcrumb.Add(new(Model.Category.Name, $"/categoria/{Model.Category.Slug}"));

                var collectionJsonLd = StructuredDataBuilder.BuildCollectionPage(
                    Model.Category.Name,
                    Model.Category.Description,
                    pageUrl,
                    Model.Articles.Select(a => new ArticleListItem(a.Article.Title, $"/articulos/{a.Article.Slug}")),
                    structuredDataBaseUrl);
                var breadcrumbJsonLd = StructuredDataBuilder.BuildBreadcrumbList(breadcrumb, structuredDataBaseUrl);
            }
            @JsonLd.Render(collectionJsonLd)
            @JsonLd.Render(breadcrumbJsonLd)
        }

