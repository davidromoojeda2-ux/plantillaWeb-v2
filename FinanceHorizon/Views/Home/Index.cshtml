@model HomePageViewModel
@{
    ViewData["Title"] = "Noticias de energía solar, baterías y autoconsumo";
    ViewData["MetaDescription"] = "Noticias, guías y análisis sobre energía solar, baterías y autoconsumo. Información práctica para ahorrar y ganar autonomía.";
    var lead = Model.Hero.Lead;
    var heroLeadImage = lead?.Image;
    ViewData["OgImage"] = heroLeadImage?.Url;

    var publicationsHref = Model.EntriesHeader.LinkHref ?? Url.Action("Index", "Publicaciones");
    var stats = Model.TextoPersuasivo;
    var categoryCards = Model.CategorySection.Cards;
    var mainCategories = Model.CategorySection.MainCategories;

    var heroSearch = new FinanceHorizon.Models.Publicaciones.SearchBarViewModel(
        IsHeroSearch: true,
        FormClass: "hp-search",
        InputClass: "hp-search__input",
        ButtonClass: "hp-btn hp-btn--accent");
    var ctaSearch = new FinanceHorizon.Models.Publicaciones.SearchBarViewModel(
        IsHeroSearch: true,
        FormClass: "hp-search hp-search--on-light",
        InputClass: "hp-search__input",
        ButtonClass: "hp-btn hp-btn--primary",
        InputId: "cta-search-input");
}

@functions {
    // Flecha sólida de los botones (equivalente al ▶ de la referencia).
    private static Microsoft.AspNetCore.Html.HtmlString ArrowIcon() => new(
        "<svg class=\"hp-btn__icon\" width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M1 0l9 5-9 5z\" fill=\"currentColor\"/></svg>");
}

<div class="home hp">
    <!-- ─── 1. Hero: propuesta de valor + buscador ─────────────────────────────── -->
    <section class="hp-hero" id="inicio" aria-labelledby="hero-title">
        <div class="container hp-hero__inner">
            <div class="hp-hero__heading">
                @if (!string.IsNullOrWhiteSpace(Model.Hero.Eyebrow))
                {
                    <p class="hp-eyebrow hp-eyebrow--on-dark">@Model.Hero.Eyebrow</p>
                }
                <h1 id="hero-title" class="hp-display">@Model.Hero.Title</h1>
            </div>
            <div class="hp-hero__aside">
                <p class="hp-hero__lead">@Model.Hero.Subtitle</p>
                <partial name="Partials/_SearchBar" model="heroSearch" />
            </div>
        </div>
    </section>

    <!-- ─── 2. Destacados: artículo principal + lista ──────────────────────────── -->
    @if (lead is not null)
    {
        <section class="hp-featured" aria-labelledby="destacados-title">
            <div class="container">
                <div class="hp-featured__panel">
                    <h2 id="destacados-title" class="sr-only">Artículos destacados</h2>

                    @* La imagen principal ocupa todo el ancho del panel; texto y lista van debajo *@
                    <a class="hp-lead__media" href="@lead.Href" tabindex="-1" aria-hidden="true">
                        @if (lead.Image.HasUrl)
                        {
                            <img src="@lead.Image.Url" srcset="@lead.Image.SrcSet"
                                 sizes="(min-width: 1536px) 1400px, 100vw"
                                 alt="@lead.Image.Alt" width="@lead.Image.Width" height="@lead.Image.Height"
                                 fetchpriority="high" decoding="async" />
                        }
                    </a>

                    <article class="hp-lead">
                        <div class="hp-lead__body">
                            <span class="hp-eyebrow">@lead.Category</span>
                            <h3 class="hp-lead__title"><a href="@lead.Href">@lead.Title</a></h3>
                            @if (!string.IsNullOrWhiteSpace(lead.Text))
                            {
                                <p class="hp-lead__summary">@lead.Text</p>
                            }
                            <p class="hp-meta">
                                @if (lead.PublishedAt is DateTime leadDate)
                                {
                                    <time datetime="@leadDate.ToString("yyyy-MM-dd")">@leadDate.ToString("dd MMM yyyy")</time>
                                    <span aria-hidden="true">·</span>
                                }
                                <span>@lead.ReadingMinutes min de lectura</span>
                                @if (!string.IsNullOrWhiteSpace(lead.Author))
                                {
                                    <span aria-hidden="true">·</span>
                                    <span>Por @lead.Author</span>
                                }
                            </p>
                            <a class="hp-btn hp-btn--primary" href="@lead.Href" aria-label="Leer artículo: @lead.Title">
                                <span>Leer artículo</span>@ArrowIcon()
                            </a>
                        </div>
                    </article>

                    @if (Model.Hero.Secondary.Count > 0)
                    {
                        <div class="hp-featured__aside">
                            <p class="hp-label">También destacado</p>
                            <ul class="hp-featured__list">
                                @foreach (var item in Model.Hero.Secondary)
                                {
                                    <li>
                                        <a class="hp-mini" href="@item.Href">
                                            <span class="hp-mini__media">
                                                @if (item.Image.HasUrl)
                                                {
                                                    <img src="@item.Image.Url" srcset="@item.Image.SrcSet" sizes="112px"
                                                         alt="" width="112" height="84" loading="lazy" decoding="async" />
                                                }
                                            </span>
                                            <span class="hp-mini__body">
                                                <span class="hp-eyebrow">@item.Category</span>
                                                <span class="hp-mini__title">@item.Title</span>
                                            </span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- ─── 3. Franja de categorías (accesos rápidos) ──────────────────────────── -->
    @if (mainCategories.Count > 0)
    {
        <nav class="hp-strip" aria-label="Categorías">
            <div class="container">
                <ul class="hp-strip__list">
                    @foreach (var cat in mainCategories)
                    {
                        <li>
                            <a class="hp-strip__item" asp-controller="Category" asp-action="Categoria"
                               asp-route-slug="@cat.Slug">@cat.Name</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    }

    <!-- ─── 4. Últimas entradas ──────────────────────────────────────────────── -->
    @if (Model.LatestEntries.Count > 0)
    {
        <section class="hp-section" id="ultimas-entradas" aria-labelledby="@Model.EntriesHeader.HeadingId">
            <div class="container">
                <header class="hp-section__header">
                    <div>
                        <h2 id="@Model.EntriesHeader.HeadingId" class="hp-h2">@Model.EntriesHeader.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(Model.EntriesHeader.Subtitle))
                        {
                            <p class="hp-section__intro">@Model.EntriesHeader.Subtitle</p>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.EntriesHeader.LinkText) && !string.IsNullOrWhiteSpace(publicationsHref))
                    {
                        <a class="hp-btn hp-btn--primary" href="@publicationsHref">
                            <span>@Model.EntriesHeader.LinkText</span>@ArrowIcon()
                        </a>
                    }
                </header>

                <ul class="hp-grid">
                    @foreach (var entry in Model.LatestEntries)
                    {
                        <li>
                            <article class="hp-card">
                                <div class="hp-card__media">
                                    @if (entry.Image.HasUrl)
                                    {
                                        <img src="@entry.Image.Url" srcset="@entry.Image.SrcSet"
                                             sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                                             alt="@entry.Image.Alt" width="@entry.Image.Width" height="@entry.Image.Height"
                                             loading="lazy" decoding="async" />
                                    }
                                </div>
                                <span class="hp-eyebrow">@entry.Category</span>
                                <h3 class="hp-card__title"><a href="@entry.Href">@entry.Title</a></h3>
                                @if (entry.PublishedAt is DateTime entryDate)
                                {
                                    <p class="hp-meta"><time datetime="@entryDate.ToString("yyyy-MM-dd")">@entryDate.ToString("dd MMM yyyy")</time></p>
                                }
                            </article>
                        </li>
                    }
                </ul>
            </div>
        </section>
    }

    <!-- ─── 5. Lo más leído (bloque de color plano) ───────────────────────────── -->
    @if (Model.MostReadEntries.Count > 0)
    {
        <section class="hp-section hp-section--tint" id="mas-leidos" aria-labelledby="mas-leidos-title">
            <div class="container hp-split">
                <div class="hp-split__intro">
                    <h2 id="mas-leidos-title" class="hp-h2 hp-h2--xl">Lo más leído</h2>
                    <p class="hp-section__intro">Los artículos que más consultan nuestros lectores.</p>
                </div>
                <ol class="hp-rank">
                    @foreach (var entry in Model.MostReadEntries)
                    {
                        <li class="hp-rank__item">
                            <span class="hp-rank__num" aria-hidden="true">@((entry.Rank ?? 0).ToString("D2"))</span>
                            <div class="hp-rank__body">
                                <span class="hp-eyebrow">@entry.Category</span>
                                <a class="hp-rank__title" href="@entry.Href">@entry.Title</a>
                                @if (entry.ViewCount > 0)
                                {
                                    <span class="hp-meta">@entry.ViewCount.ToString("N0") lecturas</span>
                                }
                            </div>
                        </li>
                    }
                </ol>
            </div>
        </section>
    }

    <!-- ─── 6. Cifras del archivo ─────────────────────────────────────────────── -->
    <section class="hp-section" aria-labelledby="cifras-title">
        <div class="container">
            <header class="hp-section__header hp-section__header--stack">
                <h2 id="cifras-title" class="hp-h2 hp-h2--xl">@stats.Title</h2>
                <p class="hp-section__intro">@stats.HighlightText</p>
            </header>
            <ul class="hp-stats">
                <li class="hp-stat">
                    <span class="hp-stat__num">+<span data-count-to="@stats.TotalArticles">@stats.TotalArticles</span></span>
                    <span class="hp-stat__label">artículos publicados</span>
                    @if (!string.IsNullOrWhiteSpace(publicationsHref))
                    {
                        <a class="hp-btn hp-btn--outline" href="@publicationsHref"><span>Ver publicaciones</span>@ArrowIcon()</a>
                    }
                </li>
                <li class="hp-stat">
                    <span class="hp-stat__num"><span data-count-to="@stats.TotalCategories">@stats.TotalCategories</span></span>
                    <span class="hp-stat__label">categorías temáticas</span>
                    <a class="hp-btn hp-btn--outline" href="#categorias"><span>Explorar categorías</span>@ArrowIcon()</a>
                </li>
                @if (stats.TotalSubcategories > 0)
                {
                    <li class="hp-stat">
                        <span class="hp-stat__num"><span data-count-to="@stats.TotalSubcategories">@stats.TotalSubcategories</span></span>
                        <span class="hp-stat__label">especialidades</span>
                        <a class="hp-btn hp-btn--outline" href="#buscar"><span>Buscar un tema</span>@ArrowIcon()</a>
                    </li>
                }
            </ul>
        </div>
    </section>

    <!-- ─── 7. Categorías principales ─────────────────────────────────────────── -->
    @if (categoryCards.Count > 0)
    {
        <section class="hp-section hp-section--surface" id="categorias" aria-labelledby="categorias-title">
            <div class="container">
                <header class="hp-section__header">
                    <div>
                        <h2 id="categorias-title" class="hp-h2">@Model.CategorySection.Title</h2>
                        <p class="hp-section__intro">@Model.CategorySection.Subtitle</p>
                    </div>
                </header>
                <div class="hp-cat-grid">
                    @foreach (var card in categoryCards)
                    {
                        <partial name="Partials/_HomeCategoryCard" model="card" />
                    }
                </div>
            </div>
        </section>
    }

    <!-- ─── 8. CTA final ──────────────────────────────────────────────────────── -->
    <section class="hp-cta" id="buscar" aria-labelledby="cta-title">
        <div class="container hp-cta__inner">
            <div>
                <h2 id="cta-title" class="hp-h2 hp-h2--xl">¿Buscas algo concreto?</h2>
                <p class="hp-cta__text">Encuentra guías, comparativas y noticias por palabra clave.</p>
            </div>
            <partial name="Partials/_SearchBar" model="ctaSearch" />
        </div>
    </section>
</div>

@section Preloads {
    @if (heroLeadImage is { HasUrl: true })
    {
        <link rel="preload" as="image" href="@heroLeadImage.Url"
              imagesrcset="@heroLeadImage.SrcSet"
              imagesizes="(min-width: 1536px) 1400px, 100vw"
              fetchpriority="high" />
    }
}

@section Scripts {
    <script src="~/js/stats-count.js" asp-append-version="true" defer></script>
}
