@model PostCardViewModel
@{
    var isPriority = ViewData["PostCardPriority"] is true;
}

@* Tarjeta de publicación del sistema plano: imagen arriba, texto sobre superficie sólida
   y enlace "estirado" en el título (toda la tarjeta es clicable). *@
<article class="hp-card @Model.CustomClass">
    <div class="hp-card__media">
        @if (Model.Image.HasUrl)
        {
            <img src="@Model.Image.Url"
                 srcset="@Model.Image.SrcSet"
                 sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                 alt="@Model.Image.Alt"
                 width="@Model.Image.Width"
                 height="@Model.Image.Height"
                 loading="@(isPriority ? "eager" : "lazy")"
                 fetchpriority="@(isPriority ? "high" : null)"
                 decoding="async" />
        }
        else
        {
            <div class="hp-card__fallback" aria-hidden="true">
                <partial name="_SvgIcon" model="@(new SvgIcon("article", "w-11 h-11", StrokeWidth: "1.3"))" />
            </div>
        }
    </div>
    <span class="hp-eyebrow">@Model.Category</span>
    <h3 class="hp-card__title"><a href="@Model.Href">@Model.Title</a></h3>
    @if (!string.IsNullOrWhiteSpace(Model.Excerpt))
    {
        <p class="hp-card__excerpt">@Model.Excerpt</p>
    }
    @if (Model.PublishedAt is DateTime date)
    {
        <p class="hp-meta"><time datetime="@date.ToString("yyyy-MM-dd")">@date.ToString("dd MMM yyyy")</time></p>
    }
</article>
